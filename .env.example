# ==============================================================================
# VitalAI — Root Environment Configuration Template (.env.example)
# Copy this file to `.env` for local development. NEVER commit real credentials.
# ==============================================================================

# ─── Database Connection (PostgreSQL 16+) ────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitalai_dev?schema=public"

# ─── NestJS API Gateway ───────────────────────────────────────────────────────
PORT=4004
NODE_ENV=development
WEB_URL=http://localhost:3004

# ─── Authentication & Security ───────────────────────────────────────────────
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRY=7d
DEVLAB_PORTAL_API_URL=http://localhost:4000

# ─── Logging Standards ───────────────────────────────────────────────────────
LOG_ENABLED=true
LOG_LEVEL=info

# ─── AI Multi-LLM Provider Configuration ─────────────────────────────────────
# Active provider: "ollama" | "groq" | "google-ai-studio" | "openrouter" | "anthropic"
AI_PROVIDER=ollama
AI_PROVIDER_AGENT=ollama
AI_PROVIDER_CHAT=ollama

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_AGENT_MODEL=qwen3:14b

# Cloud Groq Configuration
GROQ_BASE_URL=https://api.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_AGENT_MODEL=llama-3.3-70b-versatile

# Cloud Google AI Studio Configuration
GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_MODEL=gemini-2.0-flash

# Cloud OpenRouter Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Cloud Anthropic Configuration
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
