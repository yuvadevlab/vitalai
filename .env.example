# ==============================================================================
# VitalAI — Root Environment Configuration Template (.env.example)
# Copy this file to `.env` for local development. NEVER commit real credentials.
# ==============================================================================

# ─── Database Connection (PostgreSQL 16+) ────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitalai_dev?schema=public"

# ─── NestJS API Gateway ───────────────────────────────────────────────────────
PORT=4004
NODE_ENV=development
WEB_URL=http://localhost:3004

# ─── Authentication & Security ───────────────────────────────────────────────
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRY=7d
