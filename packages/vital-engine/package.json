{
  "name": "@vitalai/vital-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure deterministic calculation engine for exercise physiology, volume landmarks, TDEE, and clinical nutrition",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "echo \"vital-engine tests skipped\""
  },
  "dependencies": {
    "@vitalai/shared-types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
