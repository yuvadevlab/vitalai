{
  "name": "@vitalai/validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Centralized Zod validation schemas and inferred types for VitalAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "echo \"validation tests skipped\""
  },
  "dependencies": {
    "@vitalai/shared-types": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
