{
  "name": "@vitalai/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design system domain primitives, biometric gauges, muscle heatmaps, and clinical AI components for VitalAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@vitalai/constants": "workspace:*",
    "@vitalai/shared-types": "workspace:*",
    "@yuva-devlab/tokens": "^1.1.1",
    "@yuva-devlab/ui": "^1.3.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
