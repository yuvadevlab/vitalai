{
  "name": "@vitalai/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma ORM PostgreSQL persistence layer and user-scoped repositories for VitalAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:studio": "prisma studio",
    "db:pull": "prisma db pull",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate && tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "db:seed": "tsx src/seeds/seed-all.ts"
  },
  "dependencies": {
    "@vitalai/shared-types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "tsx": "^4.23.15"
  }
}
