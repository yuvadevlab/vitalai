# ==============================================================================
# VitalAI Web Frontend Environment Template (apps/web/.env.example)
# Copy this file to `apps/web/.env` (or `apps/web/.env.local`) for local dev.
# ==============================================================================

# ─── Server Port Configuration ───────────────────────────────────────────────
# Port for Next.js web application (default: 3004).
PORT=3004

# ─── Public Application URLs ─────────────────────────────────────────────────
# Base public URL of the web client.
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Base HTTP URL for the VitalAI backend API.
# Defaults to http://localhost:4004.
NEXT_PUBLIC_API_URL=http://localhost:4004

# Application branding
NEXT_PUBLIC_APP_NAME="VitalAI"

# ─── DevLab SSO & Platform Gateway ───────────────────────────────────────────
# Central DevLab Gateway URL for unified single sign-on across the ecosystem.
NEXT_PUBLIC_DEVLAB_PORTAL_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DEVLAB_PORTAL_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ID=vitalai
