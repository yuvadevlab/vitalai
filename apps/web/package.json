    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.5",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
