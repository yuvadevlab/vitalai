    "@tanstack/react-query": "^5.101.1",
    "@vitalai/shared-types": "workspace:*",
    "@vitalai/ui": "workspace:*",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
