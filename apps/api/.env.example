# ==============================================================================
# VitalAI Backend API Environment Template (apps/api/.env.example)
# Copy this file to `apps/api/.env` for local development.
# ==============================================================================

# ─── Server & Network Configuration ──────────────────────────────────────────
APP_NAME=VitalAI
APP_ENV=development
HOST=0.0.0.0
PORT=4004
DEBUG=true
SECRET_KEY=vitalai_development_secret_key_change_in_production_32chars

# ─── Database & Vector Storage (PostgreSQL 16 + pgvector) ────────────────────
DATABASE_URL=postgresql+asyncpg://vitalai:vitalai_secret@localhost:5432/vitalai_db
POSTGRES_USER=vitalai
POSTGRES_PASSWORD=vitalai_secret
POSTGRES_DB=vitalai_db
POSTGRES_PORT=5432

# ─── Redis Cache & Ephemeral State ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ─── Multi-LLM Gateway (LiteLLM Router) ──────────────────────────────────────
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=ollama/llama3.2
FALLBACK_LLM_MODEL=gemini/gemini-1.5-flash
OLLAMA_API_BASE=http://localhost:11434

# Cloud Providers (Optional in local dev)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── CORS Configuration ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004
