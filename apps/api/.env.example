# ==============================================================================
# VitalAI Backend API Environment Template (apps/api/.env.example)
# Copy this file to `apps/api/.env` for local development.
# ==============================================================================

# ─── Server & Network Configuration ──────────────────────────────────────────
APP_NAME=VitalAI
APP_ENV=development
NODE_ENV=development
HOST=0.0.0.0
PORT=4004
DEBUG=true
WEB_URL=http://localhost:3004

# ─── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=vitalai_development_secret_key_change_in_production_32chars

# ─── DevLab Ecosystem Service URLs ───────────────────────────────────────────
DEVLAB_PORTAL_API_URL=http://localhost:3015

# ─── Database & Vector Storage (PostgreSQL 16) ───────────────────────────────
DATABASE_URL=postgresql://yuvarajpattabi:Yuva1213@localhost:5432/vitalai_dev?schema=public
POSTGRES_USER=yuvarajpattabi
POSTGRES_PASSWORD=Yuva1213
POSTGRES_DB=vitalai_dev
POSTGRES_PORT=5432

# ─── Redis Cache & Ephemeral State ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ─── Multi-LLM Provider & Model Configurations ───────────────────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_AGENT_MODEL=qwen3:14b

# Cloud Providers (Optional in local dev)
GROQ_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ─── CORS Configuration ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004
